# Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
# You can use individual variables (Recommended for local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=chickenmaster_db

# OR use a single connection string (Optional)
# DATABASE_URL=postgres://user:password@host:port/database?sslmode=disable

# Server Configuration
PORT=3555
NODE_ENV=production

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ADMIN_PASSWORD_SALT_ROUNDS=10

# CORS
FRONTEND_URL=http://localhost:5500

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# WhatsApp Configuration
WHATSAPP_NUMBER=+970567811812

# Social Media Links
INSTAGRAM_URL=https://www.instagram.com/chicken_master26/
FACEBOOK_URL=https://www.facebook.com/profile.php?id=61587454410215

# Raffle Configuration
RAFFLE_END_DATE=2026-03-29T23:59:59

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
